{
  "name": "skytrail-travels",
  "version": "1.0.0",
  "description": "SkyTrail Travels: Unit 13 Web Design and Development coursework project (React front-end, PHP back-end).",
  "private": true,
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node bin/start.mjs",
    "dev": "node bin/dev.mjs",
    "backup": "node bin/backup.mjs",
    "db:reset": "node bin/reset-db.mjs",
    "test": "node tests/with-server.mjs node --test tests/api.test.mjs",
    "test:e2e": "node tests/with-server.mjs node --test tests/e2e.test.mjs",
    "test:db": "node --test tests/db.test.mjs",
    "test:i18n": "node --test tests/i18n.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.65.1"
  }
}
